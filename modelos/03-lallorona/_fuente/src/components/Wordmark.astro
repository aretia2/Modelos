---
/**
 * Nombre del estudio en gótica. Para usar el sello completo, ver src/assets/marca/logo.png.
 */
interface Props {
  size?: 'sm' | 'lg';
}
const { size = 'sm' } = Astro.props;
---

<span class:list={['wordmark', `wordmark--${size}`]}>La Llorona</span>

<style>
  .wordmark {
    display: inline-block;
    font-family: var(--font-display);
    font-weight: 700;
    line-height: 1;
    white-space: nowrap;
    letter-spacing: 0.005em;
  }

  .wordmark--sm {
    font-size: 1.65rem;
  }

  .wordmark--lg {
    font-size: var(--step-4);
  }
</style>
