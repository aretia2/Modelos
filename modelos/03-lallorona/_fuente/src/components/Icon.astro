---
type Name = 'arrow' | 'arrow-down' | 'instagram' | 'whatsapp' | 'phone' | 'pin' | 'close' | 'prev' | 'next' | 'drop' | 'star' | 'expand';
interface Props {
  name: Name;
  class?: string;
  size?: number;
}
const { name, class: className, size } = Astro.props;
const filled = name === 'drop' || name === 'star';
---

<svg
  class:list={[name === 'arrow' && 'arrow', className]}
  viewBox={name === 'drop' ? '0 0 24 32' : '0 0 24 24'}
  width={size ?? (name === 'drop' ? '0.75em' : '1em')}
  height={size ? (name === 'drop' ? (size * 32) / 24 : size) : '1em'}
  fill={filled ? 'currentColor' : 'none'}
  stroke={filled ? 'none' : 'currentColor'}
  stroke-width="1.6"
  stroke-linecap="square"
  aria-hidden="true"
  focusable="false"
>
  {name === 'arrow' && <path d="M3 12h17M14 5.5 20.5 12 14 18.5" />}
  {name === 'arrow-down' && <path d="M12 3v17M5.5 14 12 20.5 18.5 14" />}
  {name === 'prev' && <path d="M15 4.5 7.5 12l7.5 7.5" />}
  {name === 'next' && <path d="M9 4.5 16.5 12 9 19.5" />}
  {name === 'close' && <path d="M5 5l14 14M19 5 5 19" />}
  {name === 'expand' && <path d="M4 10V4h6M20 14v6h-6M4 4l6.5 6.5M20 20l-6.5-6.5" />}
  {
    name === 'instagram' && (
      <>
        <rect x="3.5" y="3.5" width="17" height="17" rx="4.5" />
        <circle cx="12" cy="12" r="4" />
        <circle cx="17.2" cy="6.8" r="0.6" fill="currentColor" />
      </>
    )
  }
  {
    name === 'whatsapp' && (
      <path d="M4 20l1.2-4.1A8 8 0 1 1 8.3 19L4 20Zm5-11.5c.3 2.7 3.6 6 6.4 6.4l1.2-1.4-1.9-1-1 .8c-1-.4-2.3-1.7-2.7-2.7l.8-1-1-1.9L9 8.5Z" />
    )
  }
  {name === 'phone' && <path d="M5 4h4l1.5 4.5-2.3 1.4a11 11 0 0 0 5.9 5.9l1.4-2.3L20 15v4a1 1 0 0 1-1 1A16 16 0 0 1 4 5a1 1 0 0 1 1-1Z" />}
  {name === 'pin' && (<><path d="M12 21s-7-6.1-7-11.5a7 7 0 0 1 14 0C19 14.9 12 21 12 21Z" /><circle cx="12" cy="9.5" r="2.5" /></>)}
  {name === 'drop' && <path d="M12 0S0 14.2 0 20.6A11.8 11.4 0 0 0 12 32a11.8 11.4 0 0 0 12-11.4C24 14.2 12 0 12 0Z" />}
  {name === 'star' && <path d="M12 0l1.9 10.1L24 12l-10.1 1.9L12 24l-1.9-10.1L0 12l10.1-1.9Z" />}
</svg>
